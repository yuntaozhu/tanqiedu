
{
  "rewrites": [
    {
      "source": "/ideogram-proxy/:match*",
      "destination": "https://api.ideogram.ai/:match*"
    },
    {
      "source": "/ideogram-img/:match*",
      "destination": "https://ideogram.ai/:match*"
    },
    {
      "source": "/replicate-proxy/:match*",
      "destination": "https://api.replicate.com/:match*"
    },
    {
      "source": "/planecourse-media/:match*",
      "destination": "https://5dsvuv46abrfygzd.public.blob.vercel-storage.com/planecourse/:match*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
